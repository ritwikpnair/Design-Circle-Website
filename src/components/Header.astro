---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="w-full bg-white">
  <div class="mx-auto w-[calc(100%-2rem)] max-w-[1280px]">
    <div class="flex items-center justify-between gap-3 py-3">
      <div class="flex items-center gap-3">
        <a href="/" class="flex h-10 items-center justify-center bg-neutral-950 px-4 text-lg font-bold tracking-[-0.06em] text-neutral-100 shadow-[0_4px_10px_rgba(0,0,0,0.2)] no-underline transition-opacity hover:opacity-90">
          <span class="-translate-y-px">{SITE_TITLE}</span>
        </a>
        <nav class="flex items-center gap-2" aria-label="Primary navigation left">
          <HeaderLink href="/about" class="rounded-full bg-neutral-200/90 px-4 py-2.5 text-sm font-medium text-neutral-900 shadow-[0_2px_0_rgba(0,0,0,0.06)] hover:bg-[#e6e6e6]">About</HeaderLink>
          <HeaderLink href="/contact" class="rounded-full bg-neutral-200/90 px-4 py-2.5 text-sm font-medium text-neutral-900 shadow-[0_2px_0_rgba(0,0,0,0.06)] hover:bg-[#e6e6e6]">Contact</HeaderLink>
        </nav>
      </div>

      <nav class="flex items-center justify-end gap-2" aria-label="Primary navigation right">
        <HeaderLink href="/blog" class="rounded-full border-2 border-[#c9c9c9] bg-neutral-200/90 px-4 py-2.5 text-sm font-medium text-neutral-900 shadow-[0_2px_0_rgba(0,0,0,0.06)] hover:bg-[#e6e6e6]">Blog</HeaderLink>
        <HeaderLink href="/projects" class="rounded-full border-2 border-[#c9c9c9] bg-neutral-200/90 px-4 py-2.5 text-sm font-medium text-neutral-900 shadow-[0_2px_0_rgba(0,0,0,0.06)] hover:bg-[#e6e6e6]">Projects</HeaderLink>
        <HeaderLink href="/events" class="rounded-full border-2 border-[#c9c9c9] bg-neutral-200/90 px-4 py-2.5 text-sm font-medium text-neutral-900 shadow-[0_2px_0_rgba(0,0,0,0.06)] hover:bg-[#e6e6e6]">Events</HeaderLink>
      </nav>
    </div>
  </div>
</header>
