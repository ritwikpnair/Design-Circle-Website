---
const companyLinks = ['Contact Us', 'Work', 'Blog', 'Careers', 'About', 'Sitemap'];
const serviceColumns = [
  {
    title: 'Design & Marketing',
    items: ['Digital Product Design', 'UX Design & Wireframes', 'Creative Web Design', 'Digital Strategy', 'eCommerce Branding', 'Content Marketing', 'Growth Marketing', 'Paid Search Ads', 'Email Marketing'],
  },
  {
    title: 'Development',
    items: ['Android App Development', 'iOS App Development', 'Web Development', 'React Native Development', 'Enterprise App Development', 'CMS Development', 'Node.js Development', 'Full Stack Development', 'Progressive App Development', 'Blockchain App Development'],
  },
  {
    title: 'Industries',
    items: ['FinTech', 'eCommerce', 'Travel', 'Social Media', 'Blockchain/Web3', 'Healthcare', 'Startups', 'SaaS', 'Non-Profit', 'Marketplace'],
  },
];
---

<footer class="mx-auto mt-6 w-[calc(100%-2rem)] max-w-[1280px] overflow-hidden rounded-t-[18px] bg-[#d4d4d4] text-neutral-900 shadow-[0_-8px_24px_rgba(0,0,0,0.08)]">
  <div class="flex min-h-[120px] items-center justify-between gap-6 border-b border-neutral-900/40 px-4 py-5 md:px-5">
    <div class="flex h-[120px] w-[110px] items-center justify-center" aria-hidden="true">
      <div class="flex h-14 w-14 items-center justify-center rounded-full bg-neutral-950 text-[2.2rem] font-bold tracking-[-0.08em] text-neutral-100">D</div>
    </div>

    <div class="flex w-full items-center justify-end gap-2 rounded-full bg-white/10 px-5 py-3 text-[clamp(1.2rem,2vw,2rem)] tracking-[-0.04em]">
      <span>If you'd like to work with us,</span>
      <a href="/contact" class="font-medium text-blue-700 underline-offset-4 hover:underline">get in touch.</a>
      <span class="inline-flex h-8 w-8 items-center justify-center rounded-xl bg-white/70 text-xl font-semibold text-neutral-900">→</span>
    </div>
  </div>

  <div class="grid gap-8 border-b border-neutral-900/40 px-4 pb-5 pt-7 md:grid-cols-[0.9fr_0.9fr_1.2fr_1.2fr_1fr] md:px-5">
    <div class="flex flex-col gap-2 text-base leading-relaxed text-neutral-900">
      <div>NY-LA-SF</div>
      <div>646 669 9140</div>
      <div>Instagram</div>
      <div>LinkedIn</div>
      <div>X</div>
    </div>

    <div class="flex flex-col gap-2 text-base text-neutral-900">
      {companyLinks.map((link) => <a href="#" class="hover:underline">{link}</a>)}
    </div>

    {serviceColumns.map((column) => (
      <div class="flex flex-col gap-2 text-base text-neutral-900">
        <h3 class="mb-1 text-base font-bold">{column.title}</h3>
        {column.items.map((item) => <span>{item}</span>)}
      </div>
    ))}
  </div>

  <div class="flex items-center justify-between gap-4 px-4 py-4 text-base text-neutral-900 md:px-5">
    <div class="flex flex-wrap items-center gap-3">
      <span class="inline-block h-2.5 w-2.5 rounded-full bg-neutral-900"></span>
      <span>Terms of Service</span>
      <span>Privacy Policy</span>
    </div>
  </div>
</footer>
