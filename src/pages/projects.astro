---
import { getCollection, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const projectEntries = await Promise.all(
  projects.map(async (project) => {
    const { Content } = await render(project);
    return { project, Content };
  }),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Projects | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body class="m-0 bg-white text-neutral-900 antialiased">
    <Header />
    <main class="mx-auto w-[calc(100%-2rem)] max-w-[1280px] pb-12 pt-6">
      <h1 class="mb-6 text-[clamp(4.2rem,5vw,7rem)] font-bold leading-[0.9] tracking-[-0.08em] text-neutral-900">Projects</h1>
      <section class="grid gap-4 md:grid-cols-2" aria-label="Projects">
        {projects.map((project) => (
          <article
            class="flex flex-col overflow-hidden rounded-[22px] border-2 border-[#c9c9c9] bg-white/45 shadow-[0_12px_30px_rgba(17,17,17,0.08)] backdrop-blur-md transition-all duration-200 ease-out hover:-translate-y-0.5 hover:border-[#a8a8a8] hover:shadow-[0_16px_30px_rgba(17,17,17,0.12)]"
            data-project-id={project.id}
            aria-label={`Open ${project.data.title}`}
          >
            <div class="block cursor-pointer text-inherit no-underline outline-none focus-visible:ring-2 focus-visible:ring-black/20" role="button" tabindex="0" aria-label={`Open ${project.data.title}`}>
              {project.data.heroImage && (
                <img
                  class="block h-[250px] w-full object-cover bg-neutral-950"
                  src={project.data.heroImage.src}
                  alt={project.data.title}
                />
              )}
              <div class="grid gap-1 px-3.5 pb-3.5 pt-3">
                <h2 class="m-0 text-[clamp(1.5rem,2vw,2.2rem)] font-medium leading-[1.1] tracking-[-0.05em] text-neutral-900">{project.data.title}</h2>
                <p class="m-0 text-base text-neutral-800">{project.data.description}</p>
                <span class="mt-1 text-base font-medium text-blue-700">Open Project</span>
              </div>
            </div>
          </article>
        ))}
      </section>
    </main>

    {projectEntries.map(({ project, Content }) => (
      <div class="project-overlay" id={`project-${project.id}`} data-project-overlay={project.id} aria-hidden="true">
        <div class="project-overlay-backdrop" data-project-close></div>
        <div class="project-modal-panel" role="dialog" aria-modal="true" aria-label={project.data.title}>
          <button class="project-close" type="button" aria-label="Close project view" data-project-close>×</button>

          <div class="project-modal-shell">
            <div class="project-modal-header">
              <div class="project-modal-brand">
                <span class="mini-avatar">V</span>
                <div>
                  <strong>Vladislav Soloviev</strong>
                  <small>Creative portfolio</small>
                </div>
              </div>
              <button class="follow-btn" type="button">Follow</button>
            </div>

            <div class="project-modal-hero">
              <div class="project-modal-copy">
                <p class="eyebrow">Featured project</p>
                <h2>{project.data.title}</h2>
                <p class="project-summary">{project.data.description}</p>
              </div>

              {project.data.heroImage && (
                <div class="project-modal-media">
                  <img src={project.data.heroImage.src} alt={project.data.title} />
                </div>
              )}
            </div>

            <div class="project-modal-body">
              <Content />
            </div>
          </div>
        </div>
      </div>
    ))}

    <Footer />

    <script>
      const getProjectId = (element: HTMLElement | null): string =>
        String(element?.dataset?.projectId ?? '');

      const closeModal = (overlay: HTMLElement | null): void => {
        if (!overlay) return;
        overlay.classList.remove('is-open');
        overlay.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('modal-open');
      };

      const openModal = (projectId: string): void => {
        const overlay = document.getElementById(`project-${projectId}`) as HTMLElement | null;
        if (!overlay) return;
        overlay.classList.add('is-open');
        overlay.setAttribute('aria-hidden', 'false');
        document.body.classList.add('modal-open');
      };

      document.addEventListener('click', (event: MouseEvent) => {
        const target = event.target;

        if (!(target instanceof Element)) return;

        const closeButton = target.closest('[data-project-close]');
        const card = target.closest('[data-project-id]');

        if (closeButton) {
          const overlay = closeButton.closest('.project-overlay') as HTMLElement | null;
          closeModal(overlay);
          return;
        }

        if (card) {
          const projectId = getProjectId(card as HTMLElement);
          if (projectId) openModal(projectId);
        }
      });

      document.addEventListener('keydown', (event: KeyboardEvent) => {
        if (event.key === 'Enter' || event.key === ' ') {
          const trigger = document.activeElement?.closest('[data-project-id]') as HTMLElement | null;
          if (!trigger) return;
          event.preventDefault();
          const projectId = getProjectId(trigger);
          if (projectId) openModal(projectId);
        }

        if (event.key === 'Escape') {
          document.querySelectorAll('.project-overlay.is-open').forEach((overlay) => {
            closeModal(overlay as HTMLElement);
          });
        }
      });
    </script>
  </body>
</html>

<style>
  .blog-page-body.modal-open {
    overflow: hidden;
  }

  .project-overlay {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px 18px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 180ms ease, visibility 180ms ease;
    z-index: 50;
  }

  .project-overlay.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .project-overlay-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(12, 12, 12, 0.7);
    backdrop-filter: blur(6px);
  }

  .project-modal-panel {
    position: relative;
    z-index: 1;
    width: min(1100px, calc(100vw - 36px));
    max-height: calc(100vh - 64px);
    overflow: auto;
    border-radius: 18px;
    background: #f8f7f5;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.42);
  }

  .project-close {
    position: fixed;
    top: 24px;
    right: 24px;
    z-index: 60;
    width: 42px;
    height: 42px;
    border: 1px solid rgba(17,17,17,0.12);
    border-radius: 50%;
    background: rgba(255,255,255,0.9);
    color: #111;
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 12px 28px rgba(0,0,0,0.18);
  }

  .project-modal-shell {
    background: #f8f7f5;
  }

  .project-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px 18px;
    background: rgba(17, 17, 17, 0.03);
    border-bottom: 1px solid rgba(17, 17, 17, 0.08);
  }

  .project-modal-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .mini-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #111;
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .project-modal-brand strong {
    display: block;
    font-size: 1.2rem;
    letter-spacing: -0.05em;
  }

  .project-modal-brand small {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(17, 17, 17, 0.6);
  }

  .follow-btn {
    border: 1px solid rgba(17, 17, 17, 0.2);
    background: rgba(17, 17, 17, 0.04);
    color: #111;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 10px 18px;
    cursor: pointer;
  }

  .project-modal-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(260px, 0.9fr);
    gap: 20px;
    align-items: center;
    padding: 24px 24px 18px;
  }

  .eyebrow {
    margin: 0 0 12px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(17, 17, 17, 0.66);
  }

  .project-modal-copy h2 {
    margin: 0;
    font-size: clamp(2.5rem, 3vw + 1rem, 5rem);
    line-height: 0.96;
    letter-spacing: -0.08em;
    color: #111;
  }

  .project-summary {
    margin: 14px 0 0;
    max-width: 36rem;
    font-size: 1.05rem;
    line-height: 1.6;
    color: rgba(17,17,17,0.72);
  }

  .project-modal-media {
    border-radius: 20px;
    overflow: hidden;
    background: #d8d8d8;
  }

  .project-modal-media img {
    display: block;
    width: 100%;
    height: 340px;
    object-fit: cover;
  }

  .project-modal-body {
    padding: 18px 24px 36px;
  }

  .project-modal-body .prose {
    margin: 0 auto;
    max-width: 980px;
    color: #111;
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .project-modal-body h2,
  .project-modal-body h3,
  .project-modal-body h4 {
    margin: 2em 0 0.75em;
    line-height: 1.1;
    letter-spacing: -0.06em;
    color: #111;
  }

  .project-modal-body p {
    margin: 0 0 1.3em;
  }

  .project-modal-body blockquote {
    margin: 1.8em 0;
    padding: 1em 1.2em;
    border-left: 3px solid rgba(17,17,17,0.55);
    background: rgba(17,17,17,0.04);
    border-radius: 0 12px 12px 0;
    color: rgba(17,17,17,0.7);
    font-style: italic;
  }

  .project-modal-body img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 520px;
    object-fit: cover;
    border-radius: 18px;
    margin: 1.8em 0;
  }

  .project-modal-body .media-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin: 2em 0;
  }

  .project-modal-body .media-grid img {
    margin: 0;
  }

  .project-modal-body .full-bleed {
    margin: 2.2em 0;
  }

  @media (max-width: 820px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }

    .project-modal-hero {
      grid-template-columns: 1fr;
    }

    .project-modal-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .project-modal-body .media-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
