---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Contact | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="contact-page-body">
		<Header />
		<main class="contact-page-shell">
			<h1>Contact Us</h1>

			<div class="contact-grid">
				<section class="info-panel">
					<div class="info-card info-card-top">
						<h2>Phone/ Numbers</h2>
						<p>Numbers</p>
					</div>

					<div class="info-card info-card-bottom">
						<h2>Social Media Handles</h2>
						<p>Instagram</p>
					</div>
				</section>

				<section class="visual-panel" aria-label="Illustration or animation panel">
					<div class="visual-card">Illustration or animation</div>
				</section>
			</div>
		</main>

		<Footer />
	</body>
</html>

<style>
	.contact-page-body {
		margin: 0;
		background: #d7d7d7;
		color: #111;
		font-family: Arial, Helvetica, sans-serif;
	}

	.contact-page-shell {
		max-width: 1280px;
		margin: 0 auto;
		padding: 0 18px 0;
		box-sizing: border-box;
	}

	.contact-page-shell h1 {
		margin: 18px 0 18px;
		font-size: clamp(5rem, 7vw, 10rem);
		line-height: 0.9;
		letter-spacing: -0.08em;
		font-weight: 700;
		color: #111;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
		gap: 18px;
        padding-bottom: 2rem;
		align-items: stretch;
	}

	.info-panel {
		display: flex;
		flex-direction: column;
		gap: 18px;
	}

	.info-card {
		display: flex;
		flex-direction: column;
		justify-content: center;
		height: 180px;
		background: #d3d3d3;
		padding: 18px 22px;
		box-sizing: border-box;
	}

	.info-card h2 {
		margin: 0 0 8px;
		font-size: clamp(2rem, 3vw, 3.6rem);
		line-height: 1.1;
		letter-spacing: -0.06em;
		font-weight: 500;
		color: #111;
	}

	.info-card p {
		margin: 0;
		font-size: clamp(1.2rem, 2vw, 1.8rem);
		line-height: 1.3;
		color: #111;
	}

	.visual-panel {
		display: flex;
	}

	.visual-card {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 378px;
		background: #111;
		color: #f3f3f3;
		text-align: center;
		font-size: clamp(2.2rem, 3vw, 4rem);
		line-height: 1.1;
		letter-spacing: -0.06em;
		font-weight: 500;
		padding: 24px;
		box-sizing: border-box;
	}

	.contact-footer {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 220px;
		background: #d3d3d3;
		margin-top: 42px;
		font-size: clamp(2.5rem, 3vw, 4rem);
		letter-spacing: -0.06em;
		font-weight: 700;
		color: #111;
	}

	@media (max-width: 760px) {
		.contact-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
