---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Contact | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="contact-page">
			<h1>Contact Us</h1>

			<div class="contact-grid">
				<section class="contact-stack" aria-label="Contact information">
					<div class="contact-card">
						<h2>Phone</h2>
						<p>+91 600-329-2231</p>
						<p>+91 700-268-2883</p>
					</div>

					<div class="contact-card">
						<h2>Email</h2>
						<p>designcircleclub@cit.ac.in</p>
					</div>
				</section>

				<section class="contact-illustration" aria-label="Illustration or animation panel">
				</section>
			</div>
		</main>

		<Footer />
	</body>
</html>
