---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Contact | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body class="m-0 bg-[#d7d7d7] text-neutral-900 antialiased">
    <Header />
    <main class="mx-auto max-w-7xl px-4 pb-8">
      <h1 class="mt-4 mb-5 text-[clamp(5rem,7vw,10rem)] font-bold leading-[0.9] tracking-[-0.08em] text-neutral-900">Contact Us</h1>

      <div class="grid gap-4 pb-8 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]">
        <section class="flex flex-col gap-4">
          <div class="flex h-[180px] flex-col justify-center bg-[#d3d3d3] px-6 py-5">
            <h2 class="mb-2 text-[clamp(2rem,3vw,3.6rem)] font-medium leading-[1.1] tracking-[-0.06em] text-neutral-900">Phone/ Numbers</h2>
            <p class="m-0 text-[clamp(1.2rem,2vw,1.8rem)] text-neutral-900">Numbers</p>
          </div>

          <div class="flex h-[180px] flex-col justify-center bg-[#d3d3d3] px-6 py-5">
            <h2 class="mb-2 text-[clamp(2rem,3vw,3.6rem)] font-medium leading-[1.1] tracking-[-0.06em] text-neutral-900">Social Media Handles</h2>
            <p class="m-0 text-[clamp(1.2rem,2vw,1.8rem)] text-neutral-900">Instagram</p>
          </div>
        </section>

        <section class="flex" aria-label="Illustration or animation panel">
          <div class="flex h-[378px] w-full items-center justify-center bg-neutral-950 px-6 text-center text-[clamp(2.2rem,3vw,4rem)] font-medium leading-[1.1] tracking-[-0.06em] text-neutral-100">Illustration or animation</div>
        </section>
      </div>
    </main>

    <Footer />
  </body>
</html>
