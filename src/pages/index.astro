---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getSortedCollection } from '../lib/content';

const posts = await getSortedCollection('blog');
const latestPost = posts[0];
const sidebarPosts = posts.slice(1, 6);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="page-shell">
      <section class="home-grid">
        {latestPost ? (
          <a class="story-card featured-story" href={`/blog/${latestPost.id}/`} aria-label={`Read ${latestPost.data.title}`}>
            <div class="featured-visual">
              {latestPost.data.heroImage ? (
                <Image width={1200} height={600} src={latestPost.data.heroImage} alt={latestPost.data.title} class="hero-image" />
              ) : (
                <span>{latestPost.data.title}</span>
              )}
            </div>
            <div class="featured-copy">
              <h2>{latestPost.data.title}</h2>
              <div class="featured-meta">
                <span>{latestPost.data.description}</span>
                <span><FormattedDate date={latestPost.data.pubDate} /></span>
              </div>
            </div>
          </a>
        ) : (
          <div class="story-card">
            <div class="featured-visual">Latest Post</div>
            <div class="featured-copy">
              <h2>Latest Post</h2>
              <div class="featured-meta">
                <span>Latest post description</span>
                <span>Date/Time</span>
              </div>
            </div>
          </div>
        )}

        <aside class="sidebar-list" aria-label="Latest stories">
          <h2 style="margin: 0%;">Related Posts</h2>
          {sidebarPosts.map((post) => (
            <a class="sidebar-card" href={`/blog/${post.id}/`}>
              <div class="sidebar-inner">
                <div class="sidebar-thumb">
                  {post.data.heroImage && (
                    <Image width={500} height={250} src={post.data.heroImage} alt={post.data.title} class="hero-image" />
                  )}
                </div>
                <div class="sidebar-info">
                    <div class="sidebar-label">{post.data.title}</div>
                    {post.data.pubDate && (
                      <div class="sidebar-pub">{post.data.pubDate}</div>
                    )}
                    {post.data.description && (
                      <div class="sidebar-description">{post.data.description}</div>
                    )}
                </div>
              </div>
            </a>
          ))}
        </aside>
      </section>
    </main>

    <Footer />
  </body>
</html>
