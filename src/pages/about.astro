---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import PhotoTile from '../assets/tile-website.jpeg'
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="page-shell">
			<section class="about-hero-block" style="--index: 1;">
				<div class="about-hero-content">
					<h1 class="about-hero-title">About Us</h1>
				</div>
			</section>

			<div class="about-grid" style="--index: 2;">
				<!-- Achievements (Wide Top Left) -->
				<div class="about-tile tile-achievements" style="justify-content: center; align-items: center;">
					<div class="tile-label">
						<span style="font-size: clamp(1.5rem, 2vw, 2.5rem); font-weight: 600; ">Achievements</span>
					</div>
					<div class="tile-hover-content">
						<p>Recognized for excellence in interactive media design and innovative web development solutions.</p>
					</div>
				</div>

				<!-- Photo (Tall Right Column spanning both rows) -->
				<div class="about-tile tile-photo dark" style="background-image: url('tile-website.png'); background-size: cover;">
					<div class="tile-label">
						<span style="font-size: clamp(1.5rem, 2vw, 2.5rem); font-weight: 600;"></span>
					</div>
					<div class="tile-hover-content">
						<p>Visual essays and street photography tracking light, shadow, and architectural textures.</p>
					</div>
				</div>

				<!-- Animation (Bottom Left) -->
				<div class="about-tile tile-animation dark">
					<div class="tile-label">
						<span style="font-size: clamp(1.2rem, 1.8vw, 2rem); font-weight: 600;">Anuva</span>
					</div>
					<div class="tile-hover-content">
						<p>Exploring character rigging, kinetic wire structures, and mockumentary-style sequences.</p>
					</div>
				</div>

				<!-- Stats (Bottom Middle) -->
				<div class="about-tile tile-stats">
					<div class="tile-label">
						<span style="font-size: 1.2rem; font-weight: 500;">Stats</span>
					</div>
					<div class="tile-hover-content">
						<p>Engaged across workshops, design sprints, and community-driven collaborative events.</p>
					</div>
				</div>
			</div>
			<div class="story-pin-container" id="story-section">
				<section class="about-story" style="--index: 3;  background-image: url('pattern-3.png')">
					<div class="about-story-row">
						<div class="about-story-index">01</div>
						<div class="about-story-copy">
							<h2 style="color: white;">Our Story</h2>
							<p style="color: white;">Description</p>
						</div>
					</div>
					<div class="about-story-figure">02</div>
				</section>
			</div>
		</main>
		<Footer />
		<script>
			function updateNavbarHeight() {
				// Select your navbar element (change 'header' to your specific navbar class if needed)
				const navbar = document.querySelector('header');
				if (navbar) {
				const height = navbar.offsetHeight;
				// Sets a CSS variable --navbar-height on the root html element
				document.documentElement.style.setProperty('--navbar-height', `${height}px`);
				}
			}

			// Run on initial load
			updateNavbarHeight();

			// Recalculate if the window resizes (handles responsive mobile menu changes)
			window.addEventListener('resize', updateNavbarHeight);
		</script>
		<script>
			window.addEventListener('scroll', () => {
				// Select all your layers in sequence
				const stickyLayers = document.querySelectorAll('.about-hero, .about-hero-block, .about-grid, .about-story');

				stickyLayers.forEach((layer, index) => {
				const nextLayer = stickyLayers[index + 1];
				
				if (nextLayer) {
					// Use getBoundingClientRect().top relative to the viewport + current scroll
					const nextRect = nextLayer.getBoundingClientRect();
					
					// When the top of the next layer enters the screen (e.g. 80% down the viewport)
					const triggerHeight = window.innerHeight * 0.8;

					if (nextRect.top <= triggerHeight) {
					layer.classList.add('is-faded');
					} else {
					layer.classList.remove('is-faded');
					}
				}
				});
			}, { passive: true });
		</script>
		<script>
			const storySection = document.querySelector('.about-story') as HTMLElement | null;
			const container = document.getElementById('story-section') as HTMLElement | null;
			const indexEl = storySection?.querySelector('.about-story-index') as HTMLElement | null;
			const titleEl = storySection?.querySelector('.about-story-copy h2') as HTMLElement | null;
			const descEl = storySection?.querySelector('.about-story-copy p') as HTMLElement | null;
			const figureEl = storySection?.querySelector('.about-story-figure') as HTMLElement | null;

			interface StoryStep {
				num: string;
				title: string;
				desc: string;
				figure: string;
			}

			const storySteps: StoryStep[] = [
				{
				num: "01",
				title: "Our Story",
				desc: "Description of the initial founding, vision, and core roots.",
				figure: "02"
				},
				{
				num: "02",
				title: "Growth & Vision",
				desc: "Expanding design sprints, technical art exploration, and collaboration.",
				figure: "03"
				},
				{
				num: "03",
				title: "Growth & Vision",
				desc: "Expanding design sprints, technical art exploration, and collaboration.",
				figure: "04"
				},
				{
				num: "04",
				title: "Growth & Vision",
				desc: "Expanding design sprints, technical art exploration, and collaboration.",
				figure: "05"
				}
			];

			function updateStoryContent(): void {
				if (!container || !storySection || !indexEl || !titleEl || !descEl) return;

				const rect = container.getBoundingClientRect();
				const scrollDistance = container.offsetHeight - window.innerHeight;

				// Track progress precisely from when the container enters the top of the viewport
				let progress = -rect.top / scrollDistance;
				progress = Math.max(0, Math.min(1, progress));

				// Map progress directly to total steps
				const totalSteps = storySteps.length;
				let currentStepIndex = Math.floor(progress * totalSteps);
				if (currentStepIndex >= totalSteps) {
				currentStepIndex = totalSteps - 1;
				}

				const currentData = storySteps[currentStepIndex];

				if (indexEl.textContent !== currentData.num) {
				indexEl.style.opacity = '0';
				titleEl.style.opacity = '0';
				descEl.style.opacity = '0';
				if (figureEl) figureEl.style.opacity = '0';

				setTimeout(() => {
					if (!indexEl || !titleEl || !descEl) return;
					indexEl.textContent = currentData.num;
					titleEl.textContent = currentData.title;
					descEl.textContent = currentData.desc;
					if (figureEl) figureEl.textContent = currentData.figure;

					indexEl.style.opacity = '1';
					titleEl.style.opacity = '1';
					descEl.style.opacity = '1';
					if (figureEl) figureEl.style.opacity = '1';
				}, 150);
				}
			}

			window.addEventListener('scroll', updateStoryContent, { passive: true });
			window.addEventListener('resize', updateStoryContent);
		</script>
		<script>
			window.addEventListener('scroll', () => {
				// Select all your layers in sequence
				const stickyLayers = document.querySelectorAll('.about-story-figure .about-story-index');

				stickyLayers.forEach((layer, index) => {
				const nextLayer = stickyLayers[index + 1];
				
				if (nextLayer) {
					// Use getBoundingClientRect().top relative to the viewport + current scroll
					const nextRect = nextLayer.getBoundingClientRect();
					
					// When the top of the next layer enters the screen (e.g. 80% down the viewport)
					const triggerHeight = window.innerHeight * 0.8;

					if (nextRect.top <= triggerHeight) {
					layer.classList.add('is-faded');
					} else {
					layer.classList.remove('is-faded');
					}
				}
				});
			}, { passive: true });
		</script>
	</body>
</html>

