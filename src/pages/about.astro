---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`About | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body class="m-0 bg-[#2f2f2f] text-neutral-900 antialiased">
    <Header />
    <main class="min-h-screen bg-[#c5c5c5]">
      <section class="flex min-h-[calc(100vh-126px)] items-end bg-[#c5c5c5] px-8 py-7">
        <div class="mx-auto w-full max-w-7xl">
          <div class="mb-3 text-center text-[clamp(2rem,2vw+1.2rem,3.1rem)] font-medium tracking-[-0.05em] text-neutral-900">Photo/Video/GIF</div>
          <h1 class="m-0 text-[clamp(4rem,7vw,8rem)] font-bold leading-[0.9] tracking-[-0.08em] text-neutral-100">About Us</h1>
        </div>
      </section>

      <div class="mx-auto max-w-7xl px-4 pb-4">
        <section class="grid gap-3 bg-[#c5c5c5] pt-3 md:grid-cols-[1.5fr_1.1fr_0.8fr]" aria-label="About highlights">
          <div class="flex h-28 items-center justify-center bg-[#d8d8d8] text-[clamp(1.4rem,2vw,2.4rem)] font-medium tracking-[-0.05em] text-neutral-900">Achievements</div>
          <div class="flex h-28 items-center justify-center bg-[#d8d8d8] text-[clamp(1.4rem,2vw,2.4rem)] font-medium tracking-[-0.05em] text-neutral-900">Orientation<br />stats</div>
          <div class="flex h-[214px] items-center justify-center bg-neutral-950 text-[clamp(2.4rem,3vw,4rem)] font-medium tracking-[-0.05em] text-neutral-100">P</div>
          <div class="flex h-28 items-center justify-center bg-[#d8d8d8] text-[clamp(1.4rem,2vw,2.4rem)] font-medium tracking-[-0.05em] text-neutral-900">Stats</div>
          <div class="flex h-[194px] items-center justify-center bg-neutral-950 text-[clamp(1.4rem,2vw,2.4rem)] font-medium tracking-[-0.05em] text-neutral-100">Animation</div>
          <div class="flex h-[88px] items-center justify-center bg-[#d8d8d8] text-[clamp(1.4rem,2vw,2.4rem)] font-medium tracking-[-0.05em] text-neutral-900">Events Description</div>
        </section>

        <section class="relative h-[100vh] bg-[#c5c5c5] pt-8">
          <div class="flex items-center gap-4 px-4 sm:gap-6">
            <div class="text-[clamp(5rem,7vw,11rem)] font-bold leading-[0.7] tracking-[-0.08em] text-white/80">01</div>
            <div class="space-y-3 pb-2">
              <h2 class="m-0 text-[clamp(2.8rem,4vw,5rem)] font-bold leading-none tracking-[-0.07em] text-neutral-900">Our Story</h2>
              <p class="m-0 text-lg text-neutral-900">Description</p>
            </div>
          </div>

          <div class="mt-6 flex items-center justify-between border-t-2 border-neutral-900/60 px-4 pt-4 text-[clamp(1.4rem,2vw,2rem)] font-medium tracking-[-0.05em] text-neutral-900">
            <span>Scroll</span>
            <button type="button" aria-label="Scroll" class="h-11 w-[110px] border-0 bg-transparent text-[3rem] leading-none text-neutral-900">→</button>
          </div>

          <div class="absolute bottom-4 right-4 text-[clamp(5rem,8vw,12rem)] font-bold leading-[0.7] tracking-[-0.08em] text-white/80">02</div>
        </section>
      </div>
    </main>
    <Footer />
  </body>
</html>
