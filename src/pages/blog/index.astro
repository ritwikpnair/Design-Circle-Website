---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featuredPost = posts[0];
const remainingPosts = posts.slice(1);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="blog-page-body">
		<Header />
		<main class="blog-page-shell">
			<h1>Browse our Blogs</h1>

			{featuredPost && (
				<section class="feature-post" aria-label="Featured post">
					<a class="feature-link" href={`/blog/${featuredPost.id}/`}>
						{featuredPost.data.heroImage && (
							<Image
								class="feature-media"
								width={1280}
								height={280}
								src={featuredPost.data.heroImage}
								alt={featuredPost.data.title}
							/>
						)}
					</a>
				</section>
			)}

			<section class="blog-grid" aria-label="Blog posts">
				{remainingPosts.map((post) => (
					<article class="post-card">
						<a class="post-link" href={`/blog/${post.id}/`}>
							{post.data.heroImage && (
								<Image
									class="post-media"
									width={720}
									height={320}
									src={post.data.heroImage}
									alt={post.data.title}
								/>
							)}
							<div class="post-meta">
								<h2>{post.data.title}</h2>
								<p>{post.data.description}</p>
								<span>Read Post</span>
							</div>
						</a>
					</article>
				))}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.blog-page-body {
		margin: 0;
		background: #d7d7d7;
		color: #111;
		font-family: Arial, Helvetica, sans-serif;
	}

	.blog-page-shell {
		max-width: 1280px;
		margin: 0 auto;
		padding: 0 18px 40px;
		box-sizing: border-box;
	}

	.blog-page-shell h1 {
		margin: 16px 0 18px;
		font-size: clamp(4.2rem, 5vw, 7rem);
		line-height: 0.9;
		letter-spacing: -0.08em;
		font-weight: 700;
		color: #111;
	}

	.feature-post {
		margin-bottom: 22px;
	}

	.feature-link,
	.post-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.feature-media {
		display: block;
		height: 60vh;
		width: 100%;
		object-fit: cover;
		background: #111;
	}

	.blog-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 18px 18px;
	}

	.post-card {
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.post-media {
		display: block;
		height: 250px;
		width: 100%;
		object-fit: cover;
		background: #111;
	}

	.post-meta {
		display: grid;
		grid-template-columns: 1fr;
		gap: 4px;
		padding: 12px 14px 14px;
		background: #cfcfcf;
		box-sizing: border-box;
	}

	.post-meta h2 {
		margin: 0;
		font-size: clamp(1.5rem, 2vw, 2.2rem);
		line-height: 1.1;
		letter-spacing: -0.05em;
		font-weight: 500;
		color: #111;
	}

	.post-meta p {
		margin: 0;
		font-size: 1rem;
		color: rgba(17, 17, 17, 0.8);
	}

	.post-meta span {
		margin-top: 2px;
		font-size: 1rem;
		font-weight: 500;
		color: #111;
	}

	@media (max-width: 760px) {
		.blog-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
