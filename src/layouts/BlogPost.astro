---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      :root {
        --page-bg: #ffffff;
        --text: #171717;
        --muted: #5f5f5f;
        --rule: rgba(23, 23, 23, 0.12);
        --code-bg: #111827;
        --code-inline: #f3f4f6;
        --link: #111827;
      }

      body {
        margin: 0;
        background: var(--page-bg);
        color: var(--text);
        font-family: Arial, Helvetica, sans-serif;
      }

      .article-shell {
        max-width: 1180px;
        margin: 0 auto;
        padding: 28px 0 64px;
      }

      .article-inner {
        max-width: 760px;
        margin: 0 auto;
      }

      .hero-image {
        margin: 0 0 1.5rem;
        border-radius: 18px;
        overflow: hidden;
        background: #111827;
      }

      .hero-image img {
        display: block;
        width: 100%;
        height: auto;
        object-fit: cover;
      }

      .date {
        margin: 0 0 0.8rem;
        color: var(--muted);
        font-size: 0.94rem;
      }

      h1 {
        margin: 0;
        font-size: clamp(2.8rem, 4vw, 5rem);
        line-height: 0.94;
        letter-spacing: -0.08em;
        font-weight: 700;
        color: var(--text);
      }

      .article-divider {
        height: 1px;
        margin: 1.5rem 0 0;
        background: var(--rule);
      }

      .prose {
        margin-top: 1.5rem;
        color: var(--text);
        font-size: clamp(1.05rem, 0.38vw + 0.9rem, 1.2rem);
        line-height: 1.8;
        letter-spacing: -0.01em;
      }

      .prose > :first-child {
        margin-top: 0;
      }

      .prose :where(h1, h2, h3, h4, h5, h6) {
        margin-top: 2.1em;
        margin-bottom: 0.8em;
        line-height: 1.08;
        letter-spacing: -0.05em;
        color: var(--text);
      }

      .prose :where(h1) {
        font-size: clamp(2.2rem, 2vw + 1rem, 3.2rem);
      }

      .prose :where(h2) {
        font-size: clamp(1.8rem, 1.5vw + 1rem, 2.5rem);
      }

      .prose :where(h3) {
        font-size: clamp(1.4rem, 1vw + 0.9rem, 1.9rem);
      }

      .prose :where(p, ul, ol, blockquote, pre, table, img) {
        margin-top: 0;
        margin-bottom: 1.5rem;
      }

      .prose :where(a) {
        color: var(--link);
        text-decoration: underline;
        text-underline-offset: 0.12em;
      }

      .prose :where(strong, b) {
        font-weight: 700;
      }

      .prose :where(ul, ol) {
        padding-left: 1.5em;
      }

      .prose :where(li) {
        margin-bottom: 0.45em;
      }

      .prose :where(blockquote) {
        margin: 1.8rem 0;
        padding-left: 1rem;
        border-left: 3px solid rgba(23, 23, 23, 0.45);
        color: var(--muted);
        font-style: italic;
      }

      .prose :where(code) {
        border-radius: 0.4rem;
        background: var(--code-inline);
        border: 1px solid rgba(23, 23, 23, 0.08);
        padding: 0.12em 0.45em;
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
        font-size: 0.9em;
      }

      .prose :where(pre) {
        position: relative;
        overflow-x: auto;
        padding: 1.2rem 1rem 1rem;
        border-radius: 0.9rem;
        background: var(--code-bg);
        color: #f8fafc;
        border: 1px solid rgba(17, 17, 17, 0.12);
        box-shadow: 0 12px 28px rgba(17, 17, 17, 0.08);
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
        font-size: 0.9rem;
        line-height: 1.7;
      }

      .prose :where(pre)::before {
        content: "";
        position: absolute;
        top: 0.9rem;
        left: 1rem;
        display: block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #f87171;
        box-shadow: 1.4rem 0 0 #fbbf24, 2.8rem 0 0 #4ade80;
      }

      .prose :where(pre code) {
        background: transparent;
        padding: 0;
        border: none;
        color: inherit;
      }

      .prose :where(img) {
        display: block;
        max-width: 100%;
        height: auto;
        border-radius: 12px;
        margin: 2rem auto;
      }

      .prose :where(hr) {
        border: none;
        border-top: 1px solid var(--rule);
        margin: 2.25rem 0;
      }

      .prose :where(table) {
        width: 100%;
        border-collapse: collapse;
        overflow: hidden;
        border: 1px solid var(--rule);
        border-radius: 12px;
      }

      .prose :where(th, td) {
        padding: 0.7rem 0.9rem;
        border-bottom: 1px solid var(--rule);
        text-align: left;
      }

      .prose :where(th) {
        background: #f5f5f5;
        font-weight: 700;
      }

      @media (max-width: 640px) {
        .article-shell {
          padding-inline: 0.75rem;
        }
      }
    </style>
  </head>

  <body>
    <Header />
    <main class="article-shell">
      <article class="article-inner">
        {heroImage && (
          <div class="hero-image">
            <Image width={1020} height={510} src={heroImage} alt={title} />
          </div>
        )}

        <div class="date">
          <FormattedDate date={pubDate} />
          {updatedDate && (
            <span> • Updated <FormattedDate date={updatedDate} /></span>
          )}
        </div>

        <h1>{title}</h1>
        <div class="article-divider"></div>

        <div class="prose">
          <slot />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
