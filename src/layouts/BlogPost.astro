---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			:root {
				--article-bg: #d8d8d8;
				--article-panel: rgba(255, 255, 255, 0.2);
				--article-text: #111111;
				--article-muted: #4e4e4e;
				--article-rule: rgba(17, 17, 17, 0.4);
				--article-link: #0f5ec7;
			}

			body {
				background: var(--article-bg);
				color: var(--article-text);
				font-family: Arial, Helvetica, sans-serif;
			}

			main {
				width: 100%;
				margin: 0;
				padding: 0;
				background: var(--article-bg);
			}

			.article-shell {
				max-width: 1180px;
				margin: 0 auto;
				padding: 18px 18px 60px;
				box-sizing: border-box;
			}

			.article-header {
				display: grid;
				grid-template-columns: minmax(180px, 220px) minmax(0, 1fr);
				gap: 28px;
				align-items: start;
				max-width: 1160px;
				margin: 0 auto;
				padding-top: 12px;
			}

			.author-column {
				padding-top: 8px;
			}

			.author-card {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 8px;
				padding-top: 10px;
				text-align: center;
			}

			.author-avatar {
				width: 54px;
				height: 54px;
				border-radius: 50%;
				background: #bcbcbc;
				border: 1px solid rgba(17, 17, 17, 0.18);
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 1.2rem;
				font-weight: 700;
				color: #111;
			}

			.author-name {
				margin: 0;
				font-size: 1.1rem;
				font-weight: 700;
				letter-spacing: -0.04em;
			}

			.author-bio {
				margin: 0;
				font-size: 0.95rem;
				line-height: 1.5;
				color: var(--article-muted);
			}

			.author-follow {
				display: inline-block;
				margin-top: 4px;
				padding: 6px 10px;
				border: 1px solid rgba(17, 17, 17, 0.5);
				border-radius: 999px;
				font-size: 0.82rem;
				font-weight: 600;
				text-decoration: none;
				color: #111;
			}

			.article-main {
				max-width: 760px;
				margin: 0 auto;
			}

			.hero-image {
				width: 100%;
				margin: 0 auto 14px;
				border-radius: 18px;
				overflow: hidden;
			}

			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				border-radius: 18px;
				object-fit: cover;
				background: #111;
			}

			.title {
				padding: 0 0 10px;
				margin: 0;
			}

			.date {
				margin: 0 0 16px;
				font-size: 0.95rem;
				letter-spacing: 0.02em;
				color: var(--article-muted);
				text-transform: none;
			}

			.title h1 {
				margin: 0;
				font-size: clamp(2.5rem, 3vw + 1.25rem, 5rem);
				line-height: 0.96;
				letter-spacing: -0.07em;
				font-weight: 700;
				color: #111;
			}

			.article-divider {
				height: 1px;
				background: var(--article-rule);
				margin: 18px 0 0;
			}

			.prose {
				max-width: 760px;
				margin: 0 auto;
				padding: 1.2em 0 0;
				color: var(--article-text);
				font-size: 1.15rem;
				line-height: 1.7;
				letter-spacing: -0.01em;
			}

			.prose > *:first-child {
				margin-top: 0;
			}

			.prose p {
				margin: 0 0 1.55em;
			}

			.prose h2,
			.prose h3,
			.prose h4 {
				margin: 2em 0 0.8em;
				letter-spacing: -0.05em;
				line-height: 1.1;
				color: #111;
			}

			.prose h2 {
				font-size: clamp(1.8rem, 1.7vw + 1rem, 2.8rem);
			}

			.prose h3 {
				font-size: clamp(1.45rem, 1.2vw + 1rem, 2.1rem);
			}

			.prose a {
				color: var(--article-link);
				text-decoration: underline;
				text-underline-offset: 0.12em;
			}

			.prose strong {
				font-weight: 700;
			}

			.prose code {
				padding: 0.14em 0.44em;
				border-radius: 6px;
				background: rgba(177, 176, 176, 0.87);
				border: 1px solid rgba(105, 105, 105, 0.842);
				font-family: Consolas, Monaco, monospace;
				font-size: 0.9em;
				font-weight: 500;
			}

			.prose pre {
				position: relative;
				overflow: auto;
				padding: 2.7rem 1.15rem 1rem;
				border-radius: 12px;
				background: #1e1e1f;
				color: #f2f2f2;
				margin: 1.7em 0;
				border: 1px solid rgba(17, 17, 17, 0.22);
				box-shadow: 0 8px 20px rgba(17, 17, 17, 0.08);
				font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
				font-size: 0.88rem;
				line-height: 1.7;
				letter-spacing: 0;
			}

			.prose pre::before {
				content: "";
				position: absolute;
				top: 0.9rem;
				left: 1rem;
				display: block;
				width: 10px;
				height: 10px;
				border-radius: 50%;
				background: #f26a6a;
				box-shadow: 1.35rem 0 0 #f1bf5d, 2.7rem 0 0 #58c76d;
			}

			.prose pre::after {
				content: attr(data-language);
				position: absolute;
				top: 0.8rem;
				right: 1.2rem;
				font-size: 0.68rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: rgba(255, 255, 255, 0.72);
			}

			.prose pre code,
			.prose pre .line {
				display: block;
				white-space: pre;
				min-height: 1.5em;
				font-family: inherit;
				font-size: inherit;
				line-height: inherit;
			}

			.prose pre code {
				background: transparent;
				padding: 0;
				border: none;
				color: inherit;
			}

			.prose ul,
			.prose ol {
				margin: 0 0 1.5em 1.5em;
				padding: 0;
			}

			.prose li {
				margin-bottom: 0.5em;
			}

			.prose blockquote {
				margin: 1.6em 0;
				padding-left: 1rem;
				border-left: 3px solid rgba(17, 17, 17, 0.5);
				color: var(--article-muted);
				font-style: italic;
			}

			.prose img {
				display: block;
				max-width: 100%;
				height: auto;
				margin: 2em auto;
				border-radius: 12px;
			}

			@media (max-width: 840px) {
				.article-header {
					grid-template-columns: 1fr;
					gap: 12px;
				}

				.author-column {
					padding-top: 0;
				}

				.author-card {
					align-items: flex-start;
					text-align: left;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article class="article-shell">
				<div class="article-header">
					<div class="author-column">
						<div class="author-card">
							<div class="author-avatar">L</div>
							<p class="author-name">Logo editorial</p>
							<p class="author-bio">Design notes, writing, and product thinking.</p>
							<a class="author-follow" href="/about">Follow</a>
						</div>
					</div>

					<div class="article-main">
						<div class="hero-image">
							{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
						</div>
						<div class="title">
							<div class="date">
								<FormattedDate date={pubDate} />
								{updatedDate && (
									<span> • Updated <FormattedDate date={updatedDate} /></span>
								)}
							</div>
							<h1>{title}</h1>
						</div>
						<div class="article-divider"></div>
						<div class="prose">
							<slot />
						</div>
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
