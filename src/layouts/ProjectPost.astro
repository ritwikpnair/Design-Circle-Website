---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLink from '../components/BaseLink.astro';

type Props = CollectionEntry<'projects'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      :root {
        --project-bg: #2a2c2f;
        --project-shell: #f5f1ee;
        --project-panel: #ece7e1;
        --project-text: #141414;
        --project-muted: #5d5d5d;
        --project-rule: rgba(20, 20, 20, 0.12);
        --project-accent: #1f4cff;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        background: var(--project-bg);
        color: var(--project-text);
        font-family: Arial, Helvetica, sans-serif;
      }

      main {
        width: 100%;
        padding: 0 16px 48px;
      }

      .project-stage {
        max-width: 1440px;
        margin: 0 auto;
      }

      .project-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        min-height: 66px;
        padding: 12px 18px;
        color: rgba(255,255,255,0.82);
      }

      .topbar-left,
      .topbar-right {
        display: flex;
        align-items: center;
        gap: 14px;
      }

      .brand-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
        border-radius: 7px;
        background: #fff;
        color: #111;
        font-size: 0.82rem;
        font-weight: 700;
      }

      .brand-word {
        font-size: 0.86rem;
        font-weight: 700;
        letter-spacing: -0.04em;
        color: #fff;
      }

      .top-link {
        font-size: 0.8rem;
        color: rgba(255,255,255,0.7);
        text-decoration: none;
      }

      .top-link:hover {
        color: #fff;
      }

      .top-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 78px;
        min-height: 32px;
        padding: 0 12px;
        border: 1px solid rgba(255,255,255,0.18);
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        background: rgba(255,255,255,0.05);
        color: #fff;
      }

      .top-action.primary {
        background: linear-gradient(135deg, #2d77ff, #6a59ff);
        border-color: transparent;
      }

      .project-sheet {
        background: var(--project-shell);
        border-radius: 18px 18px 0 0;
        overflow: hidden;
        box-shadow: 0 28px 60px rgba(0,0,0,0.2);
      }

      .project-titlebar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 18px 22px 20px;
        background: rgba(255,255,255,0.18);
        border-bottom: 1px solid rgba(17,17,17,0.08);
      }

      .title-meta {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
      }

      .mini-avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #111;
        color: #fff;
        font-size: 0.86rem;
        font-weight: 700;
      }

      .title-meta strong {
        display: block;
        font-size: 1.2rem;
        line-height: 1.2;
        letter-spacing: -0.05em;
      }

      .title-meta small {
        display: block;
        color: var(--project-muted);
        font-size: 0.7rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .follow-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 38px;
        padding: 0 18px;
        border: 1px solid rgba(17,17,17,0.25);
        background: rgba(17,17,17,0.04);
        border-radius: 999px;
        font-size: 0.74rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #111;
      }

      .project-hero {
        display: grid;
        align-items: center;
        min-height: 520px;
        padding: 26px 22px 10px;
        background: rgba(255,255,255,0.14);
      }

      .project-hero-inner {
        display: grid;
        grid-template-columns: minmax(0, 1.5fr) minmax(260px, 0.8fr);
        gap: 24px;
        align-items: end;
      }

      .hero-copy {
        padding: 10px 8px 0;
      }

      .hero-copy h1 {
        margin: 0;
        font-size: clamp(2.8rem, 3.1vw + 1.25rem, 6rem);
        line-height: 0.92;
        letter-spacing: -0.08em;
        font-weight: 700;
      }

      .hero-copy p {
        max-width: 38rem;
        margin: 18px 0 0;
        font-size: 1.05rem;
        line-height: 1.6;
        color: var(--project-muted);
      }

      .hero-media {
        position: relative;
        border-radius: 22px;
        overflow: hidden;
        background: #d6d6d6;
        min-height: 240px;
      }

      .hero-media img {
        display: block;
        width: 100%;
        height: 100%;
        min-height: 320px;
        object-fit: cover;
      }

      .project-meta-band {
        display: flex;
        justify-content: space-between;
        gap: 18px;
        align-items: center;
        padding: 16px 26px;
        background: rgba(17,17,17,0.04);
        border-top: 1px solid var(--project-rule);
        border-bottom: 1px solid var(--project-rule);
      }

      .chip-row {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
      }

      .meta-chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 12px;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        background: rgba(17,17,17,0.08);
        color: #111;
      }

      .project-body {
        padding: 32px 22px 52px;
      }

      .prose {
        max-width: 980px;
        margin: 0 auto;
        color: var(--project-text);
        font-size: 1.05rem;
        line-height: 1.7;
      }

      .prose > *:first-child {
        margin-top: 0;
      }

      .prose p {
        margin: 0 0 1.3em;
      }

      .prose h2,
      .prose h3 {
        margin: 2.2em 0 0.8em;
        letter-spacing: -0.06em;
        line-height: 1.1;
      }

      .prose h2 {
        font-size: clamp(2rem, 2vw + 1rem, 3.3rem);
      }

      .prose h3 {
        font-size: clamp(1.5rem, 1.6vw + 0.8rem, 2.2rem);
      }

      .prose blockquote {
        margin: 1.8em 0;
        padding: 1em 1.2em;
        border-left: 3px solid rgba(17,17,17,0.5);
        background: rgba(17,17,17,0.04);
        border-radius: 0 14px 14px 0;
        color: var(--project-muted);
        font-style: italic;
      }

      .prose ul,
      .prose ol {
        margin: 0 0 1.5em 1.5em;
        padding: 0;
      }

      .prose li {
        margin-bottom: 0.55em;
      }

      .media-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
        margin: 2.2em 0;
      }

      .media-grid img {
        display: block;
        width: 100%;
        height: 340px;
        object-fit: cover;
        border-radius: 18px;
        background: #d3d3d3;
      }

      .full-bleed {
        margin: 2.4em 0;
      }

      .full-bleed img {
        display: block;
        width: 100%;
        height: auto;
        max-height: 560px;
        object-fit: cover;
        border-radius: 18px;
        background: #d3d3d3;
      }

      @media (max-width: 820px) {
        .project-hero-inner {
          grid-template-columns: 1fr;
        }

        .project-titlebar {
          flex-direction: column;
          align-items: flex-start;
        }

        .project-meta-band {
          flex-direction: column;
          align-items: flex-start;
        }

        .media-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <div class="project-stage">
        <div class="project-topbar">
          <div class="topbar-left">
            <span class="brand-mark">B</span>
            <span class="brand-word">Behance</span>
            <a class="top-link" href="/">Explore</a>
            <BaseLink class="top-link" href="/projects">Projects</BaseLink>
          </div>

          <div class="topbar-right">
            <span class="top-action">3D</span>
            <span class="top-action primary">Sign In</span>
          </div>
        </div>

        <article class="project-sheet">
          <div class="project-titlebar">
            <div class="title-meta">
              <span class="mini-avatar">V</span>
              <div>
                <strong>Vladislav Soloviev</strong>
                <small>Product design / direction</small>
              </div>
            </div>
            <button class="follow-btn" type="button">Follow</button>
          </div>

          <div class="project-hero">
            <div class="project-hero-inner">
              <div class="hero-copy">
                <h1>{title}</h1>
                <p>{description}</p>
              </div>

              <div class="hero-media">
                {heroImage && <Image width={860} height={620} src={heroImage} alt={title} />}
              </div>
            </div>
          </div>

          <div class="project-meta-band">
            <div class="chip-row">
              <span class="meta-chip">Design</span>
              <span class="meta-chip">CG</span>
              <span class="meta-chip">Brand</span>
            </div>
            <div class="chip-row">
              <span class="meta-chip">Published <FormattedDate date={pubDate} /></span>
              {updatedDate && <span class="meta-chip">Updated <FormattedDate date={updatedDate} /></span>}
            </div>
          </div>

          <div class="project-body">
            <div class="prose">
              <slot />
            </div>
          </div>
        </article>
      </div>
    </main>
    <Footer />
  </body>
</html>
